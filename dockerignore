# Ce qui ne doit PAS entrer dans l'image.
# Même esprit que .gitignore, autre finalité : ici on réduit la taille de l'image
# et le temps de construction, et on évite d'embarquer des fichiers de la machine
# de développement (un .venv compilé pour macOS serait inutilisable sous Linux).

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

.git/
.gitignore
.github/

data/
notebooks/
*.ipynb
.ipynb_checkpoints/

.DS_Store
Dockerfile
.dockerignore
